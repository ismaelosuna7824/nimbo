# Copy to `.env` (or `.env.local`) and fill in. Values are read at build time.

# Public URL of the site, without trailing slash (e.g. https://nimbo.web.app).
# When set: canonical, hreflang and Open Graph URLs become absolute and
# /sitemap-index.xml is generated. When empty: relative URLs, no sitemap.
SITE_URL=

# Firebase web app config (Firebase console → Project settings → General →
# Your apps → Web app → SDK setup and configuration → Config).
# Analytics (and the cookie consent banner) is enabled ONLY when ALL seven are
# set. Leave any of them empty to build a site with no banner and no Firebase.
# These values are public by design (they ship in the browser bundle).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
# Google Analytics measurement ID, starts with G- (requires Analytics enabled
# in the Firebase project).
PUBLIC_FIREBASE_MEASUREMENT_ID=
