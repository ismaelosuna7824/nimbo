---
/**
 * Analytics consent. Rendered only when Firebase is configured (see Layout).
 * The choice is stored in localStorage; the footer "Cookie settings" button
 * ([data-consent-open]) re-opens it.
 */
import { t, type Lang } from "../i18n";

interface Props {
  lang: Lang;
}

const s = t(Astro.props.lang);
---

<section
  id="consent"
  class="consent fixed inset-x-3 bottom-3 z-[60] mx-auto max-w-xl rounded-2xl border border-border-strong bg-surface-2/95 p-4 shadow-2xl shadow-black/60 backdrop-blur-xl sm:inset-x-auto sm:right-5 sm:bottom-5 sm:p-5"
  aria-labelledby="consent-title"
  hidden
>
  <h2 id="consent-title" class="text-sm font-semibold">{s.consent.title}</h2>
  <p class="mt-1.5 text-sm leading-relaxed text-muted">{s.consent.text}</p>
  <div class="mt-4 flex gap-2">
    <button type="button" class="btn btn-sm btn-primary" data-consent="granted">{s.consent.accept}</button>
    <button type="button" class="btn btn-sm btn-ghost" data-consent="denied">{s.consent.decline}</button>
  </div>
</section>

<style>
  .consent:not([hidden]) {
    animation: consent-in 320ms var(--ease-out-soft) both;
  }
  @keyframes consent-in {
    from {
      opacity: 0;
      transform: translateY(12px);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .consent:not([hidden]) {
      animation: none;
    }
  }
</style>

<script>
  import { readConsent, writeConsent, type Consent } from "../lib/analytics";
  import { startAnalytics, stopAnalytics } from "../lib/firebase";

  const banner = document.getElementById("consent");

  function apply(choice: Consent) {
    if (choice === "granted") void startAnalytics();
    else void stopAnalytics();
  }

  if (banner) {
    const stored = readConsent();
    if (stored) apply(stored);
    else banner.hidden = false;

    banner.addEventListener("click", (event) => {
      const button = (event.target as Element).closest<HTMLButtonElement>("[data-consent]");
      if (!button) return;
      const choice = button.dataset.consent === "granted" ? "granted" : "denied";
      writeConsent(choice);
      banner.hidden = true;
      apply(choice);
    });

    for (const opener of document.querySelectorAll<HTMLElement>("[data-consent-open]")) {
      opener.addEventListener("click", () => {
        banner.hidden = false;
        banner.querySelector<HTMLButtonElement>("[data-consent]")?.focus();
      });
    }
  }
</script>
