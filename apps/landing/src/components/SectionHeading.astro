---
interface Props {
  eyebrow: string;
  title: string;
  sub?: string;
  id?: string;
  align?: "center" | "left";
  class?: string;
}

const { eyebrow, title, sub, id, align = "center", class: className } = Astro.props;
---

<div class:list={["reveal max-w-2xl", align === "center" && "mx-auto text-center", className]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2 id={id} class="mt-3 text-3xl font-semibold tracking-tight text-balance sm:text-4xl lg:text-[2.75rem] lg:leading-[1.1]">
    {title}
  </h2>
  {sub && <p class="mt-4 text-base text-pretty text-muted sm:text-lg">{sub}</p>}
</div>
