---
/** A Kubernetes app on its local k3s cluster, then Convert to Kubernetes turning a compose project into a Helm chart. */
import type { Lang } from "../../i18n"
import convert from "../../assets/screens/k8s-convert.webp"
import running from "../../assets/screens/k8s-running.webp"
import { demoStrings } from "./lib/strings"
import ScreenCycle from "./ScreenCycle.astro"

interface Props {
  lang: Lang
  class?: string
}

const { lang, class: className } = Astro.props
const s = demoStrings(lang).kubernetes
---

<ScreenCycle
  id="kubernetes"
  lang={lang}
  label={s.label}
  title={s.windowTitle}
  class={className}
  shots={[
    { src: running, label: s.cluster },
    { src: convert, label: s.convert },
  ]}
/>
