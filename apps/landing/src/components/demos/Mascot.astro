---
/**
 * The Nimbo mascot (apps/desktop/src/assets/nimbo-mark.svg, pixel for pixel)
 * with a gentle float, a periodic blink and twinkling sparkles. Pure CSS;
 * still under prefers-reduced-motion. Decorative unless `decorative={false}`.
 */
interface Props {
  /** Width in px; height follows the artwork. */
  size?: number;
  /** Draw the app-icon tile behind the cloud. */
  tile?: boolean;
  decorative?: boolean;
  label?: string;
  class?: string;
}

const { size = 96, tile = false, decorative = true, label = "Nimbo", class: className } = Astro.props;
const BODY = `<rect x="28.4" y="15.8" width="7.22" height="1.82" fill="#4c1d95"/><rect x="24.8" y="17.6" width="3.62" height="1.82" fill="#4c1d95"/><rect x="28.4" y="17.6" width="7.22" height="1.82" fill="#ffffff"/><rect x="35.6" y="17.6" width="3.62" height="1.82" fill="#4c1d95"/><rect x="23" y="19.4" width="1.82" height="1.82" fill="#4c1d95"/><rect x="24.8" y="19.4" width="14.42" height="1.82" fill="#ffffff"/><rect x="39.2" y="19.4" width="1.82" height="1.82" fill="#4c1d95"/><rect x="15.8" y="21.2" width="7.22" height="1.82" fill="#4c1d95"/><rect x="23" y="21.2" width="18.02" height="1.82" fill="#ffffff"/><rect x="41" y="21.2" width="7.22" height="1.82" fill="#4c1d95"/><rect x="14" y="23" width="1.82" height="1.82" fill="#4c1d95"/><rect x="15.8" y="23" width="32.42" height="1.82" fill="#ffffff"/><rect x="48.2" y="23" width="1.82" height="1.82" fill="#4c1d95"/><rect x="12.2" y="24.8" width="1.82" height="1.82" fill="#4c1d95"/><rect x="14" y="24.8" width="36.02" height="1.82" fill="#ffffff"/><rect x="50" y="24.8" width="1.82" height="1.82" fill="#4c1d95"/><rect x="12.2" y="26.6" width="1.82" height="1.82" fill="#4c1d95"/><rect x="14" y="26.6" width="36.02" height="1.82" fill="#ffffff"/><rect x="50" y="26.6" width="1.82" height="1.82" fill="#ddd6fe"/><rect x="51.8" y="26.6" width="1.82" height="1.82" fill="#4c1d95"/><rect x="10.4" y="28.4" width="3.62" height="1.82" fill="#4c1d95"/><rect x="14" y="28.4" width="36.02" height="1.82" fill="#ffffff"/><rect x="50" y="28.4" width="1.82" height="1.82" fill="#ddd6fe"/><rect x="51.8" y="28.4" width="1.82" height="1.82" fill="#4c1d95"/><rect x="8.6" y="30.2" width="1.82" height="1.82" fill="#4c1d95"/><rect x="10.4" y="30.2" width="10.82" height="1.82" fill="#ffffff"/><rect x="24.8" y="30.2" width="14.42" height="1.82" fill="#ffffff"/><rect x="42.8" y="30.2" width="7.22" height="1.82" fill="#ffffff"/><rect x="50" y="30.2" width="1.82" height="1.82" fill="#ddd6fe"/><rect x="51.8" y="30.2" width="1.82" height="1.82" fill="#4c1d95