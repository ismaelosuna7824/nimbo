---
/** Saved connections to already-deployed services: test them, confirm before real traffic. */
import type { Lang } from "../../i18n";
import type { IconName } from "./lib/icons";
import { demoStrings } from "./lib/strings";
import Cursor from "./ui/Cursor.astro";
import DemoFrame from "./ui/DemoFrame.astro";
import Icon from "./ui/Icon.astro";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const s = demoStrings(lang).connections;

interface Conn {
  id: string;
  name: string;
  kind: string;
  target: string;
  icon: IconName;
  color: string;
  real?: boolean;
  action?: string;
  ok?: string;
  note?: string;
}

const conns: Conn[] = [
  { id: "pg", name: "orders-db", kind: "PostgreSQL", target: "db.internal:5432/orders", icon: "database", color: "#60a5fa", action: s.test, ok: s.pgOk },
  { id: "redis", name: "cache", kind: "Redis", target: "cache.internal:6379", icon: "database-zap", color: "#f87171", action: s.test, ok: s.redisOk },
  { id: "http", name: "staging-api", kind: "HTTP API", target: "https://staging-api.example.com", icon: "globe", color: "#a78bfa", real: true, action: s.loadTest, ok: s.httpOk },
  { id: "aws", name: "aws-staging", kind: "AWS", target: "profile staging · eu-west-1", icon: "cloud", color: "#f97316", real: true, note: s.awsNote },
];
---

<DemoFrame id="connections" lang={lang} label={s.label} title={s.windowTitle} class={className}>
  <div class="wrap" data-fade>
    <div class="cards">
      {
        conns.map((c) => (
          <div class="card" data-conn={c.id}>
            <div class="head">
              <span class="ic" style={{ "--c": c.color }}>
                <Icon name={c.icon} size={13} />
              </span>
              <span class="txt">
                <span class="name">{c.name}</span>
                <span class="kind">{c.kind}</span>
              </span>
              {c.real && <span class="real">{s.real}</span>}
            </div>
            <span class="target">{c.target}</span>
            <div class="foot">
              {c.action && <span class="btn">{c.action}</span>}
              {c.ok && (
                <span class="st" data-state="ok" data-state0="idle">
                  <span class="st-busy">
                    <span class="spin" />
                    {c.id === "http" ? s.smoke : s.testing}
                  </span>
                  <span class="st-ok">
                    <Icon name="circle-check" size={11} />
                    {c.ok}
                  </span>
                </span>
              )}
              {c.note && (
                <span class="note">
                  <Icon name="lock" size={10} />
                  {c.note}
                </span>
              )}
            </div>
            {c.id === "http" && (
              <span class="bar">
                <span class="bar-fill" />
              </span>
            )}
          </div>
        ))
      }
    </div>

    <div class="overlay is-off">
      <div class="dialog" data-anim="pop">
        <span class="d-ic"><Icon name="triangle-alert" size={16} /></span>
        <span class="d-title">{s.dialogTitle}</span>
        <span class="d-text">{s.dialogText}</span>
        <dl>
          <dt>{s.target}</dt>
          <dd>https://staging-api.example.com/health</dd>
          <dt>{s.traffic}</dt>
          <dd>{s.trafficValue}</dd>
        </dl>
        <span class="d-actions">
          <span class="btn">{s.cancel}</span>
          <span class="btn btn-pri">{s.confirm}</span>
        </span>
      </div>
    </div>
    <Cursor x="50%" y="104%" />
  </div>
</DemoFrame>

<style>
  .wrap {
    position: relative;
    padding: 12px;
    background: var(--color-bg);
  }
  .cards {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
    padding: 10px;
    overflow: hidden;
    border: 1px solid var(--color-border-strong);
    border-radius: 11px;
    background: var(--color-surface);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ic {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 7px;
    background: color-mix(in srgb, var(--c) 15%, transparent);
    color: var(--c);
  }
  .txt {
    display: flex;
    flex: 1;
    flex-direction: column;
    min-width: 0;
  }
  .name {
    overflow: hidden;
    font-size: 12px;
    font-weight: 600;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .kind {
    color: var(--color-muted);
    font-size: 10px;
  }
  .real {
    flex-shrink: 0;
    padding: 0 6px;
    border: 1px solid rgb(251 191 36 / 0.4);
    border-radius: 999px;
    color: var(--color-amber);
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .target {
    overflow: hidden;
    padding: 4px 7px;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.04);
    font-family: var(--font-mono);
    font-size: 10px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    min-height: 24px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    height: 24px;
    padding: 0 9px;
    border: 1px solid var(--color-border-strong);
    border-radius: 6px;
    background: var(--color-surface-2);
    font-size: 10.5px;
    font-weight: 500;
    white-space: nowrap;
    transition:
      scale 0.15s,
      filter 0.15s;
  }
  .btn-pri {
    border-color: transparent;
    background: var(--color-primary-strong);
    color: #fff;
  }
  .st {
    display: inline-flex;
    min-width: 0;
    font-size: 10.5px;
  }
  .st > span {
    display: none;
    align-items: center;
    gap: 5px;
    white-space: nowrap;
  }
  .st[data-state="busy"] .st-busy {
    display: inline-flex;
    color: var(--color-muted);
  }
  .st[data-state="ok"] .st-ok {
    display: inline-flex;
    color: var(--color-green);
    font-weight: 500;
  }
  .spin {
    width: 9px;
    height: 9px;
    border: 1.5px solid rgb(161 161 170 / 0.35);
    border-top-color: var(--color-muted);
    border-radius: 50%;
    animation: cn-spin 0.7s linear infinite;
  }
  .note {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    color: var(--color-amber);
    font-size: 10.5px;
  }
  .bar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    height: 2px;
  }
  .bar-fill {
    position: absolute;
    inset: 0;
    background: var(--color-primary);
    transform-origin: left;
    transform: scaleX(var(--p, 1));
  }

  .overlay {
    position: absolute;
    inset: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
    background: rgb(5 5 6 / 0.72);
    backdrop-filter: blur(2px);
    transition: opacity 0.3s;
  }
  .dialog {
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: min(340px, 100%);
    padding: 14px;
    border: 1px solid var(--color-border-strong);
    border-radius: 12px;
    background: var(--color-surface-2);
    box-shadow: 0 24px 60px -16px rgb(0 0 0 / 0.95);
  }
  .d-ic {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 8px;
    background: rgb(251 191 36 / 0.12);
    color: var(--color-amber);
  }
  .d-title {
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .d-text {
    color: var(--color-muted);
    font-size: 11px;
    line-height: 1.45;
  }
  dl {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 3px 10px;
    margin: 0;
    padding: 7px 9px;
    border: 1px solid var(--color-border);
    border-radius: 8px;
    font-size: 10.5px;
  }
  dt {
    color: var(--color-muted);
  }
  dd {
    overflow: hidden;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 10px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .d-actions {
    display: flex;
    justify-content: flex-end;
    gap: 6px;
    margin-top: 2px;
  }

  @keyframes cn-spin {
    to {
      rotate: 360deg;
    }
  }

  @container (max-width: 440px) {
    .cards {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { mountDemo } from "./lib/timeline";

  mountDemo("connections", (tl) => {
    const cur = tl.$("[data-cursor]");
    const card = (id: string) => tl.$(`[data-conn="${id}"]`);
    const fill = tl.$(".bar-fill");

    let t = 300;
    for (const id of ["pg", "redis"]) {
      const btn = card(id).querySelector<HTMLElement>(".btn")!;
      const st = card(id).querySelector<HTMLElement>(".st")!;
      tl.cursor(t, cur, btn);
      tl.click(t + 700, cur);
      tl.pulse(t + 700, btn, "is-pressed", 160);
      tl.state(t + 750, st, "busy");
      tl.state(t + 1450, st, "ok");
      t += 1700;
    }

    const http = card("http");
    const httpBtn = http.querySelector<HTMLElement>(".btn")!;
    const httpSt = http.querySelector<HTMLElement>(".st")!;
    tl.cursor(t, cur, httpBtn);
    tl.click(t + 700, cur);
    tl.pulse(t + 700, httpBtn, "is-pressed", 160);
    tl.show(t + 850, ".overlay");
    tl.show(t + 850, ".dialog");
    tl.cursor(t + 1900, cur, ".dialog .btn-pri");
    tl.click(t + 2700, cur);
    tl.pulse(t + 2700, ".dialog .btn-pri", "is-pressed", 160);
    tl.hide(t + 2850, ".overlay");
    tl.state(t + 3000, httpSt, "busy");
    tl.tween(t + 3000, 1800, (p) => fill.style.setProperty("--p", String(p)));
    tl.state(t + 4900, httpSt, "ok");
    tl.cursor(t + 3100, cur, tl.root.querySelector<HTMLElement>(".wrap")!, 0.5, 1.04);
  });
</script>
