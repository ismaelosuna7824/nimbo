---
/**
 * Resource node like the app's canvas card (canvas-card.tsx): rounded card
 * with a masked cloud-colored top hairline, tinted icon tile, label + mono
 * address and ONE status row (dot + word). "Local" (hollow green ring) is
 * the default; `deployed` adds `.nc-dep` (filled green dot + "Deployed"),
 * which timelines reveal by removing `.is-off` and which replaces Local
 * while visible. Modules show the `.nc-kind` tag and no status; the default
 * slot renders in the bottom row (e.g. a module source chip).
 * Positioned by the parent via `[data-node="<id>"]` (absolute by default,
 * `flow` keeps it in the flow).
 */
import type { Lang } from "../../../i18n";
import type { IconName } from "../lib/icons";
import { demoStrings } from "../lib/strings";
import Icon from "./Icon.astro";
import Status from "./Status.astro";

const ACCENT: Record<string, string> = {
  aws: "#f97316",
  azure: "#3b82f6",
  gcp: "#22c55e",
  oci: "#ef4444",
  module: "#a855f7",
};

interface Props {
  id: string;
  lang: Lang;
  label: string;
  /** Terraform address, e.g. `aws_lambda_function.api`. */
  address: string;
  icon: IconName;
  cloud?: "aws" | "azure" | "gcp" | "oci" | "module";
  /** Show the "Local" (runs in the sandbox) status; false = no status. */
  local?: boolean;
  /** Render the "Deployed" status (`.nc-dep`, toggle it from the timeline). */
  deployed?: boolean;
  /** Entrance used by Timeline.show(). */
  anim?: "drop" | "up" | "pop" | "left" | "fade";
  flow?: boolean;
  class?: string;
}

const { id, lang, label, address, icon, cloud = "aws", local = true, deployed = false, anim = "drop", flow = false, class: className } = Astro.props;
const s = demoStrings(lang).common;
const isModule = cloud === "module";
const hasStatus = !isModule && (local || deployed);
const hasSlot = Astro.slots.has("default");
---

<div class:list={["nc", { "nc-mod": isModule, "nc-flow": flow }, className]} data-node={id} data-anim={anim} style={{ "--accent": ACCENT[cloud] }}>
  <span class="nc-line" aria-hidden="true"></span>
  <div class="nc-head">
    <span class="nc-ic"><Icon name={isModule ? "package" : icon} size={15} /></span>
    <span class="nc-txt">
      <span class="nc-label">
        <span class="nc-name">{label}</span>
        {isModule && <span class="nc-kind">{s.module}</span>}
      </span>
      <span class="nc-addr">{address}</span>
    </span>
  </div>
  {
    (hasStatus || hasSlot) && (
      <div class="nc-foot">
        {hasStatus && (
          <span class="nc-status">
            {local && <Status tone="ready" label={s.local} class="nc-local" />}
            {deployed && <Status tone="ok" label={s.deployed} class="nc-dep" data-anim="fade" />}
          </span>
        )}
        <slot />
      </div>
    )
  }
</div>

<style>
  .nc {
    position: absolute;
    display: flex;
    flex-direction: column;
    gap: 9px;
    width: var(--nw, 168px);
    padding: 9px 10px 8px;
    border: 1px solid rgb(255 255 255 / 0.08);
    border-radius: 12px;
    background: oklch(0.215 0.01 280);
    box-shadow:
      0 1px 2px rgb(0 0 0 / 0.35),
      0 8px 18px -10px rgb(0 0 0 / 0.7);
    transition:
      opacity 0.4s var(--ease-out-soft),
      translate 0.55s var(--ease-out-soft),
      scale 0.55s var(--ease-out-soft),
      box-shadow 0.3s,
      border-color 0.3s;
  }
  .nc-flow {
    position: relative;
  }
  .nc-mod {
    box-shadow:
      4px 4px 0 -1px oklch(0.19 0.01 280),
      4px 4px 0 0 rgb(255 255 255 / 0.08);
  }
  .nc.is-selected {
    border-color: var(--color-primary);
    box-shadow:
      0 0 0 2px var(--color-bg),
      0 0 0 4px rgb(139 92 246 / 0.7);
  }
  /* Cloud accent: a 1px top hairline, inset and faded at both ends. */
  .nc-line {
    position: absolute;
    top: -1px;
    right: 20px;
    left: 20px;
    height: 1px;
    background: var(--accent);
    mask-image: linear-gradient(90deg, transparent, black 30%, black 70%, transparent);
  }
  .nc-head {
    display: flex;
    align-items: center;
    gap: 9px;
    min-width: 0;
  }
  .nc-ic {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 8px;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 15%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 18%, transparent);
  }
  .nc-txt {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }
  .nc-label {
    display: flex;
    align-items: center;
    gap: 5px;
    min-width: 0;
  }
  .nc-name {
    overflow: hidden;
    font-size: 12px;
    font-weight: 600;
    line-height: 1.25;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .nc-kind {
    flex-shrink: 0;
    padding: 0 4px;
    border-radius: 4px;
    background: rgb(139 92 246 / 0.16);
    color: var(--color-primary-soft);
    font-size: 8.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }
  .nc-addr {
    overflow: hidden;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 9.5px;
    line-height: 1.2;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .nc-foot {
    display: flex;
    align-items: center;
    gap: 6px;
    min-width: 0;
    min-height: 14px;
  }
  /* Local and Deployed share one slot; Deployed replaces Local once shown. */
  .nc-status {
    display: grid;
    align-items: center;
  }
  .nc-status > :global(*) {
    grid-area: 1 / 1;
  }
  .nc:has(:global(.nc-dep:not(.is-off))) :global(.nc-local) {
    opacity: 0;
  }
</style>
