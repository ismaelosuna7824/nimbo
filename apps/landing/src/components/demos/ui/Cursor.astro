---
/** Fake mouse pointer moved by Timeline.cursor(); `x`/`y` place its resting spot. */
interface Props {
  x?: string;
  y?: string;
}

const { x = "70%", y = "75%" } = Astro.props;
---

<span data-cursor style={{ left: x, top: y }}>
  <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true" focusable="false">
    <path
      d="M3 1.8v13.4l3.4-3.2 2.4 5.2 2.3-1-2.3-5.1h4.8L3 1.8Z"
      fill="#fafafa"
      stroke="#0a0a0b"
      stroke-width="1.3"
      stroke-linejoin="round"></path>
  </svg>
  <slot />
</span>
