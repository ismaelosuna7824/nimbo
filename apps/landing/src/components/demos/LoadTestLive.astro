---
/** Load test results filling in live: KPIs, throughput and latency charts, breaking point, verdict. */
import type { Lang } from "../../i18n";
import { BREAK_AT, kpisAt, MAX_MS, MAX_RPS, SAMPLE_COUNT, seriesPath } from "./lib/loadtest-data";
import { demoStrings } from "./lib/strings";
import DemoFrame from "./ui/DemoFrame.astro";
import Icon from "./ui/Icon.astro";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const all = demoStrings(lang);
const s = all.loadtest;
const final = kpisAt(SAMPLE_COUNT - 1);
const int = new Intl.NumberFormat(lang, { maximumFractionDigits: 0 });
const pct = new Intl.NumberFormat(lang, { style: "percent", minimumFractionDigits: 2, maximumFractionDigits: 2 });
const breakX = `${((BREAK_AT / (SAMPLE_COUNT - 1)) * 100).toFixed(2)}%`;
const actuals = [`${int.format(final.p95)} ms`, pct.format(final.errorRate), pct.format(0.996)];

interface Series {
  d: string;
  color: string;
  label: string;
  width?: number;
  dash?: boolean;
}

const charts: Array<{ key: string; title: string; max: string; series: Series[] }> = [
  {
    key: "tp",
    title: s.throughput,
    max: `${MAX_RPS} req/s`,
    series: [
      { d: seriesPath("target", MAX_RPS), color: "oklch(0.6 0 0)", dash: true, label: s.target },
      { d: seriesPath("rps", MAX_RPS), color: "oklch(0.7 0.16 250)", width: 2, label: s.achieved },
    ],
  },
  {
    key: "lat",
    title: s.latency,
    max: `${MAX_MS} ms`,
    series: [
      { d: seriesPath("p50", MAX_MS), color: "oklch(0.72 0.15 155)", label: "p50" },
      { d: seriesPath("p95", MAX_MS), color: "oklch(0.78 0.15 70)", width: 2, label: "p95" },
      { d: seriesPath("p99", MAX_MS), color: "oklch(0.68 0.2 25)", label: "p99" },
    ],
  },
];
---

<DemoFrame id="loadtest" lang={lang} label={s.label} title={s.windowTitle} class={className}>
  <div class="lt" data-fade>
    <div class="head">
      <span class="verdict" data-state="pass" data-state0="run">
        <span class="v-run"><span class="spin"></span>{all.common.running}</span>
        <span class="v-pass"><Icon name="check" size={11} strokeWidth={3} />{all.common.passed}</span>
      </span>
      <span class="name">{s.name}</span>
      <span class="meta">60 s</span>
    </div>

    <div class="kpis">
      <div class="kpi"><span class="k-l">{s.kpis.requests}</span><span class="k-v" data-k="requests">{int.format(final.requests)}</span></div>
      <div class="kpi"><span class="k-l">{s.kpis.rps}</span><span class="k-v" data-k="peak">{int.format(final.peak)}</span></div>
      <div class="kpi">
        <span class="k-l">{s.kpis.p95}</span><span class="k-v"><span data-k="p95">{int.format(final.p95)}</span> ms</span>
        <span class="k-s">p50 <span data-k="p50">{int.format(final.p50)}</span> ms</span>
      </div>
      <div class="kpi"><span class="k-l">{s.kpis.errors}</span><span class="k-v ok" data-k="errors">{pct.format(final.errorRate)}</span></div>
      <div class="kpi"><span class="k-l">{s.kpis.stability}</span><span class="k-v ok"><span class="stab" data-anim="fade">{s.stable}</span></span></div>
    </div>

    <div class="charts">
      {
        charts.map((c) => (
          <div class="chart">
            <span class="c-head">
              {c.title}
              <span class="legend">
                {c.series.map((sr) => (
                  <span>
                    <i style={{ background: sr.color }} />
                    {sr.label}
                  </span>
                ))}
              </span>
            </span>
            <div class="plot">
              <span class="y-max">{c.max}</span>
              <svg viewBox="0 0 300 100" preserveAspectRatio="none" aria-hidden="true">
                <defs>
                  <clipPath id={`lt-clip-${c.key}`}>
                    <rect class="reveal" x="0" y="-10" width="300" height="120" />
                  </clipPath>
                </defs>
                <line x1="0" y1="52" x2="300" y2="52" class="grid" />
                <line x1="0" y1="4" x2="300" y2="4" class="grid" />
                <g clip-path={`url(#lt-clip-${c.key})`}>
                  {c.series.map((sr) => (
                    <path
                      d={sr.d}
                      stroke={sr.color}
                      stroke-width={sr.width ?? 1.3}
                      stroke-dasharray={sr.dash ? "4 3" : undefined}
                      fill="none"
                      vector-effect="non-scaling-stroke"
                      stroke-linejoin="round"
                    />
                  ))}
                </g>
              </svg>
              <span class="mark" style={{ left: breakX }} data-anim="fade"></span>
            </div>
          </div>
        ))
      }
      <span class="mark-label" data-anim="pop"><Icon name="triangle-alert" size={11} />{s.breaking}</span>
    </div>

    <div class="crit">
      <span class="crit-title">{s.criteria}</span>
      {
        s.thresholds.map((th, i) => (
          <span class="th" data-anim="up">
            <Icon name="check" size={11} strokeWidth={3} class="th-ok" />
            <span class="th-name">{th}</span>
            <span class="th-act">{actuals[i]}</span>
          </span>
        ))
      }
    </div>
  </div>
</DemoFrame>

<style>
  .lt {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 12px;
    background: var(--color-bg);
  }
  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }
  .verdict {
    display: inline-flex;
    align-items: center;
    height: 20px;
    padding: 0 8px;
    border-radius: 999px;
    font-size: 10.5px;
    font-weight: 600;
    transition: background 0.3s;
  }
  .verdict span {
    display: inline-flex;
    align-items: center;
    gap: 5px;
  }
  .verdict[data-state="run"] {
    background: rgb(139 92 246 / 0.18);
    color: #ddd6fe;
  }
  .verdict[data-state="pass"] {
    background: rgb(52 211 153 / 0.16);
    color: var(--color-green);
  }
  .verdict[data-state="pass"] .v-run,
  .verdict[data-state="run"] .v-pass {
    display: none;
  }
  .spin {
    width: 9px;
    height: 9px;
    border: 1.5px solid rgb(221 214 254 / 0.35);
    border-top-color: #ddd6fe;
    border-radius: 50%;
    animation: lt-spin 0.7s linear infinite;
  }
  .name {
    font-size: 12px;
    font-weight: 600;
  }
  .meta {
    color: var(--color-muted);
    font-size: 11px;
  }

  .kpis {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 6px;
  }
  .kpi {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 6px 8px;
    border: 1px solid var(--color-border-strong);
    border-radius: 8px;
    background: var(--color-surface);
  }
  .k-l {
    overflow: hidden;
    color: var(--color-muted);
    font-size: 10px;
    white-space: nowrap;
    text-overflow: ellipsis;
  }
  .k-v {
    font-size: 15px;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .k-v.ok {
    color: var(--color-green);
  }
  .k-s {
    color: var(--color-muted);
    font-size: 9.5px;
    font-variant-numeric: tabular-nums;
  }

  .charts {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 6px;
  }
  .chart {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
    padding: 7px 8px 8px;
    border: 1px solid var(--color-border-strong);
    border-radius: 8px;
    background: var(--color-surface);
  }
  .c-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 4px 8px;
    font-size: 10.5px;
    font-weight: 500;
  }
  .legend {
    display: flex;
    gap: 7px;
    color: var(--color-muted);
    font-size: 9.5px;
    font-weight: 400;
  }
  .legend span {
    display: inline-flex;
    align-items: center;
    gap: 3px;
  }
  .legend i {
    width: 8px;
    height: 2px;
    border-radius: 1px;
  }
  .plot {
    position: relative;
    height: 104px;
  }
  .plot svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .grid {
    stroke: rgb(255 255 255 / 0.06);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }
  .y-max {
    position: absolute;
    top: -2px;
    right: 0;
    color: var(--color-subtle);
    font-family: var(--font-mono);
    font-size: 8.5px;
  }
  .mark {
    position: absolute;
    top: -4px;
    bottom: 0;
    width: 0;
    border-left: 1.5px dashed var(--color-amber);
  }
  .mark-label {
    position: absolute;
    bottom: 8px;
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border: 1px solid rgb(251 191 36 / 0.45);
    border-radius: 999px;
    background: rgb(36 28 8 / 0.95);
    color: var(--color-amber);
    font-size: 10px;
    font-weight: 600;
    white-space: nowrap;
    transform: translateX(-50%);
  }

  .crit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
  }
  .crit-title {
    color: var(--color-muted);
    font-size: 10.5px;
  }
  .th {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    padding: 2px 8px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 10px;
  }
  .th :global(.th-ok) {
    color: var(--color-green);
  }
  .th-act {
    color: var(--color-muted);
  }

  @keyframes lt-spin {
    to {
      rotate: 360deg;
    }
  }

  @container (max-width: 520px) {
    .kpis {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .charts {
      grid-template-columns: 1fr;
    }
    .mark-label {
      bottom: auto;
      top: 50%;
      transform: translate(-50%, -50%);
    }
  }
</style>

<script>
  import { BREAK_AT, kpisAt, SAMPLE_COUNT } from "./lib/loadtest-data";
  import { mountDemo } from "./lib/timeline";

  mountDemo("loadtest", (tl) => {
    const lang = tl.root.dataset.lang;
    const int = new Intl.NumberFormat(lang, { maximumFractionDigits: 0 });
    const pct = new Intl.NumberFormat(lang, { style: "percent", minimumFractionDigits: 2, maximumFractionDigits: 2 });
    const field = (k: string) => tl.$(`[data-k="${k}"]`);
    const out = { requests: field("requests"), peak: field("peak"), p95: field("p95"), p50: field("p50"), errors: field("errors") };
    const reveals = tl.els(".reveal");
    const START = 600;
    const RUN = 8000;

    tl.tween(START, RUN, (p) => {
      const i = Math.round(p * (SAMPLE_COUNT - 1));
      const k = kpisAt(i);
      const w = String(p * 300);
      reveals.forEach((r) => r.setAttribute("width", w));
      out.requests.textContent = int.format(p ? k.requests : 0);
      out.peak.textContent = int.format(p ? k.peak : 0);
      out.p95.textContent = int.format(p ? k.p95 : 0);
      out.p50.textContent = int.format(p ? k.p50 : 0);
      out.errors.textContent = pct.format(p ? k.errorRate : 0);
    });
    const breakAt = START + (RUN * BREAK_AT) / (SAMPLE_COUNT - 1);
    tl.show(breakAt, ".mark");
    tl.show(breakAt + 250, ".mark-label");
    tl.state(START + RUN + 200, ".verdict", "pass");
    tl.show(START + RUN + 300, ".stab");
    tl.els(".th").forEach((th, i) => tl.show(START + RUN + 500 + i * 180, th));
  });
</script>
