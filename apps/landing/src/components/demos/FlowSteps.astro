---
/** Design → Run locally → Test → Ship Terraform, lit one by one by a traveling beam. */
import type { Lang } from "../../i18n";
import type { GlyphId, TileColorId } from "./lib/pixel";
import { demoStrings } from "./lib/strings";
import DemoFrame from "./ui/DemoFrame.astro";
import PixelTile from "./ui/PixelTile.astro";

interface Props {
  lang: Lang;
  class?: string;
}

const { lang, class: className } = Astro.props;
const s = demoStrings(lang).flow;
const look: Array<{ glyph: GlyphId; color: TileColorId; tone: string }> = [
  { glyph: "network", color: "violet", tone: "#a78bfa" },
  { glyph: "cloud", color: "cyan", tone: "#22d3ee" },
  { glyph: "bolt", color: "amber", tone: "#fbbf24" },
  { glyph: "rocket", color: "pink", tone: "#f472b6" },
];
---

<DemoFrame id="flow" lang={lang} label={s.label} chrome={false} class={className}>
  <div class="flow" style={{ "--p": 1 }}>
    <ol class="steps">
      {
        s.steps.map((step, i) => (
          <li class="step is-lit" style={{ "--i": i, "--tone": look[i]!.tone }}>
            {i < s.steps.length - 1 && (
              <span class="seg">
                <span class="seg-fill" />
              </span>
            )}
            <span class="tile">
              <PixelTile glyph={look[i]!.glyph} color={look[i]!.color} size={44} />
            </span>
            <span class="copy">
              <span class="num">{String(i + 1).padStart(2, "0")}</span>
              <span class="title">{step.title}</span>
              <span class="text">{step.text}</span>
              <span class="chip">{step.chip}</span>
            </span>
          </li>
        ))
      }
    </ol>
  </div>
</DemoFrame>

<style>
  .flow {
    padding: 22px 20px;
    background:
      radial-gradient(120% 140% at 50% 0%, rgb(139 92 246 / 0.08), transparent 60%),
      var(--color-surface);
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 14px;
    --sp: clamp(0, calc(var(--p) * 3 - var(--i)), 1);
  }

  /* Connector from this tile's center to the next one. */
  .seg {
    position: absolute;
    top: 21px;
    left: 22px;
    width: calc(100% + 20px);
    height: 2px;
    border-radius: 2px;
    background: rgb(255 255 255 / 0.08);
  }
  .seg-fill {
    position: absolute;
    inset: 0 auto 0 0;
    width: calc(var(--sp) * 100%);
    border-radius: inherit;
    background: linear-gradient(90deg, var(--tone), #c4b5fd);
    box-shadow: 0 0 10px rgb(167 139 250 / 0.7);
  }
  .seg-fill::after {
    content: "";
    position: absolute;
    top: 50%;
    right: -4px;
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #fff;
    box-shadow:
      0 0 10px 3px rgb(196 181 253 / 0.9),
      0 0 24px 6px rgb(139 92 246 / 0.6);
    translate: 0 -50%;
    opacity: calc(var(--sp) * (1 - var(--sp)) * 4);
  }

  .tile {
    position: relative;
    z-index: 1;
    display: inline-flex;
    flex-shrink: 0;
    align-self: flex-start;
    height: 44px;
    width: 44px;
    border-radius: 10px;
    filter: grayscale(1) brightness(0.55);
    transition:
      filter 0.5s,
      box-shadow 0.5s;
  }
  .tile::after {
    content: "";
    position: absolute;
    inset: -2px;
    border: 2px solid var(--tone);
    border-radius: 12px;
    opacity: 0;
  }
  .step.is-lit .tile {
    filter: none;
    box-shadow: 0 0 22px -4px var(--tone);
  }
  .step.is-lit .tile::after {
    animation: flow-ping 0.9s ease-out;
  }
  @keyframes flow-ping {
    from {
      opacity: 0.9;
      scale: 1;
    }
    to {
      opacity: 0;
      scale: 1.5;
    }
  }

  .copy {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    opacity: 0.45;
    transition: opacity 0.5s;
  }
  .step.is-lit .copy {
    opacity: 1;
  }
  .num {
    color: var(--tone);
    font-family: var(--font-mono);
    font-size: 11px;
  }
  .title {
    font-size: 15px;
    font-weight: 600;
  }
  .text {
    color: var(--color-muted);
    font-size: 12.5px;
    line-height: 1.45;
  }
  .chip {
    margin-top: 4px;
    padding: 2px 7px;
    border: 1px solid var(--color-border-strong);
    border-radius: 999px;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 10.5px;
    white-space: nowrap;
  }

  @container (max-width: 640px) {
    .steps {
      grid-template-columns: 1fr;
      gap: 18px;
    }
    .step {
      flex-direction: row;
    }
    .seg {
      top: 22px;
      left: 21px;
      width: 2px;
      height: calc(100% + 18px);
    }
    .seg-fill {
      inset: 0 0 auto 0;
      width: auto;
      height: calc(var(--sp) * 100%);
      background: linear-gradient(180deg, var(--tone), #c4b5fd);
    }
    .seg-fill::after {
      top: auto;
      right: 50%;
      bottom: -4px;
      translate: 50% 0;
    }
  }
</style>

<script>
  import { mountDemo } from "./lib/timeline";

  mountDemo("flow", (tl) => {
    const flow = tl.$(".flow");
    const SEG = 1800;
    tl.els(".step").forEach((li, i) => tl.cls(i === 0 ? 300 : 600 + i * SEG, li, "is-lit"));
    tl.tween(600, SEG * 3, (p) => flow.style.setProperty("--p", String(p)));
  });
</script>
