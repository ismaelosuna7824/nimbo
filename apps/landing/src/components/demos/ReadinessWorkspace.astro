---
/** The Readiness tab of a compose project, then the capacity planner sized from its load test. */
import type { Lang } from "../../i18n"
import capacity from "../../assets/screens/readiness-capacity.webp"
import score from "../../assets/screens/readiness-score.webp"
import { demoStrings } from "./lib/strings"
import ScreenCycle from "./ScreenCycle.astro"

interface Props {
  lang: Lang
  class?: string
}

const { lang, class: className } = Astro.props
const s = demoStrings(lang).readiness
---

<ScreenCycle
  id="readiness"
  lang={lang}
  label={s.label}
  title={s.windowTitle}
  class={className}
  shots={[
    { src: score, label: s.score },
    { src: capacity, label: s.capacity },
  ]}
/>
