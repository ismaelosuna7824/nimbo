---
import Icon from "./Icon.astro";
import PixelTile from "./demos/ui/PixelTile.astro";
import type { GlyphId, TileColorId } from "./demos/lib/pixel";

interface Props {
  id: string;
  eyebrow: string;
  title: string;
  body: string;
  bullets?: readonly string[];
  glyph: GlyphId;
  color: TileColorId;
  /** Puts the demo on the left on wide screens. */
  reverse?: boolean;
}

const { id, eyebrow, title, body, bullets = [], glyph, color, reverse = false } = Astro.props;
---

<article id={id} class="feature grid items-center gap-10 lg:grid-cols-2 lg:gap-16" aria-labelledby={`${id}-title`}>
  <div class:list={["reveal max-w-xl", reverse && "lg:order-2"]}>
    <div class="flex items-center gap-3">
      <PixelTile glyph={glyph} color={color} size={32} />
      <p class="eyebrow">{eyebrow}</p>
    </div>
    <h3 id={`${id}-title`} class="mt-4 text-2xl font-semibold tracking-tight text-balance sm:text-3xl">{title}</h3>
    <p class="mt-4 text-pretty text-muted sm:text-[1.0625rem] sm:leading-relaxed">{body}</p>
    {
      bullets.length > 0 && (
        <ul class="mt-6 space-y-3">
          {bullets.map((b) => (
            <li class="flex gap-3 text-[0.9375rem] text-fg/90">
              <span class="mt-0.5 grid size-5 shrink-0 place-items-center rounded-full bg-primary/15 text-primary-soft">
                <Icon name="check" size={13} />
              </span>
              <span>{b}</span>
            </li>
          ))}
        </ul>
      )
    }
    <slot name="extra" />
  </div>
  <div class:list={["min-w-0", reverse && "lg:order-1"]}>
    <slot />
  </div>
</article>
