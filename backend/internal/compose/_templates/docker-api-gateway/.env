# The demo consumer's API key from gateway/kong.yml. It is a test value, not
# a secret: send it as the "apikey" header (Try it, or after `set -a; . ./.env`:
# curl -H "apikey: $GATEWAY_DEMO_KEY" http://localhost:8187/users).
# Requests without it get 401. Change both places together.
GATEWAY_DEMO_KEY=demo-key-not-a-secret
