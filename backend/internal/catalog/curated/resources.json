{
  "variables": {
    "aws_region": {
      "type": "string",
      "default": "us-east-1",
      "description": "AWS region to deploy into."
    },
    "location": {
      "type": "string",
      "default": "eastus",
      "description": "Azure region of the resource groups and their resources."
    },
    "gcp_project": {
      "type": "string",
      "default": "floci-local",
      "description": "Google Cloud project ID (floci-local is the local Floci project)."
    },
    "gcp_region": {
      "type": "string",
      "default": "us-central1",
      "description": "Google Cloud region of the provider and regional resources."
    },
    "oci_region": {
      "type": "string",
      "default": "us-ashburn-1",
      "description": "OCI region to deploy into."
    },
    "compartment_ocid": {
      "type": "string",
      "default": "ocid1.tenancy.oc1..flocilocaltenancy0000000000000000000000000000000000000000",
      "description": "OCI compartment OCID for new resources (defaults to the local Floci tenancy root compartment)."
    }
  },
  "resources": {
    "aws_s3_bucket": {
      "label": "S3 Bucket", "icon": "hard-drive", "popular": true, "name": "bucket",
      "description": "Object storage for files, assets and data lakes. Starts encrypted (SSE-S3) with public access blocked.",
      "attrs": {
        "bucket": {"basic": true, "init": "{{slug}}-{{rand}}", "naming": "${local.name_prefix}-{{slug}}-{{rand}}"},
        "force_destroy": {"basic": true, "default": true, "init": true}
      },
      "companions": [
        {"type": "aws_s3_bucket_server_side_encryption_configuration", "name": "{{name}}_encryption", "init": {
          "exprs": {"bucket": "{{self}}.id"},
          "blocks": [{"type": "rule", "blocks": [{"type": "apply_server_side_encryption_by_default", "attrs": {"sse_algorithm": "AES256"}}]}]
        }},
        {"type": "aws_s3_bucket_public_access_block", "name": "{{name}}_public_access", "init": {
          "exprs": {"bucket": "{{self}}.id"},
          "attrs": {"block_public_acls": true, "block_public_policy": true, "ignore_public_acls": true, "restrict_public_buckets": true}
        }}
      ]
    },
    "aws_s3_bucket_policy": {"label": "S3 Bucket Policy", "icon": "file-lock"},
    "aws_s3_bucket_notification": {"label": "S3 Bucket Notification", "icon": "bell"},
    "aws_s3_bucket_website_configuration": {"label": "S3 Static Website", "icon": "globe"},
    "aws_s3_bucket_public_access_block": {"label": "S3 Public Access Block", "icon": "shield"},
    "aws_s3_bucket_versioning": {"label": "S3 Bucket Versioning", "icon": "archive"},
    "aws_s3_object": {"label": "S3 Object", "icon": "file"},
    "aws_sqs_queue": {
      "label": "SQS Queue", "icon": "inbox", "popular": true, "name": "queue",
      "description": "Managed message queue to decouple producers and consumers.",
      "attrs": {
        "name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "sqs_managed_sse_enabled": {"init": true},
        "visibility_timeout_seconds": {"basic": true, "default": 30},
        "message_retention_seconds": {"basic": true, "default": 345600},
        "delay_seconds": {"basic": true, "default": 0},
        "fifo_queue": {"basic": true, "default": false},
        "receive_wait_time_seconds": {"default": 0}
      }
    },
    "aws_sqs_queue_policy": {"label": "SQS Queue Policy", "icon": "file-lock"},
    "aws_sqs_queue_redrive_policy": {"label": "SQS Dead-letter Redrive", "icon": "inbox"},
    "aws_sns_topic": {
      "label": "SNS Topic", "icon": "megaphone", "popular": true, "name": "topic",
      "description": "Pub/sub topic that fans messages out to subscribers.",
      "attrs": {
        "name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "fifo_topic": {"basic": true, "default": false}
      }
    },
    "aws_sns_topic_subscription": {
      "label": "SNS Subscription", "icon": "bell-ring", "name": "subscription",
      "attrs": {
        "protocol": {"basic": true, "enum": ["sqs", "lambda", "http", "https", "email", "email-json", "sms", "application", "firehose"]},
        "topic_arn": {"basic": true},
        "endpoint": {"basic": true},
        "raw_message_delivery": {"basic": true, "default": false}
      }
    },
    "aws_sns_topic_policy": {"label": "SNS Topic Policy", "icon": "file-lock"},
    "aws_dynamodb_table": {
      "label": "DynamoDB Table", "icon": "table", "popular": true, "name": "table",
      "description": "Serverless key-value and document database. Starts with server-side encryption enabled.",
      "attrs": {
        "name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "billing_mode": {"basic": true, "enum": ["PAY_PER_REQUEST", "PROVISIONED"], "default": "PAY_PER_REQUEST", "init": "PAY_PER_REQUEST"},
        "hash_key": {"basic": true, "init": "id"},
        "range_key": {"basic": true},
        "stream_enabled": {"basic": true, "default": false},
        "stream_view_type": {"enum": ["KEYS_ONLY", "NEW_IMAGE", "OLD_IMAGE", "NEW_AND_OLD_IMAGES"]},
        "attribute.type": {"enum": ["S", "N", "B"]}
      },
      "blocks": [
        {"type": "attribute", "attrs": {"name": "id", "type": "S"}},
        {"type": "server_side_encryption", "attrs": {"enabled": true}}
      ]
    },
    "aws_lambda_function": {
      "label": "Lambda Function", "icon": "zap", "popular": true, "name": "function",
      "description": "Run code without servers. Starts with a Node.js handler in the workflow file services/<name>/src/index.mjs (zipped by an archive_file), an execution role and a log group with 14-day retention.",
      "attrs": {
        "function_name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "runtime": {"basic": true, "default": "nodejs22.x", "init": "nodejs22.x", "enum": [
          "nodejs24.x", "nodejs22.x", "python3.14", "python3.13", "python3.12", "python3.11",
          "java21", "java17", "java11", "java8.al2", "dotnet8", "ruby3.4", "ruby3.3", "provided.al2023", "provided.al2"
        ]},
        "handler": {"basic": true, "default": "index.handler", "init": "index.handler"},
        "memory_size": {"basic": true, "default": 128, "init": 128},
        "timeout": {"basic": true, "default": 10, "init": 10},
        "architectures": {"enum": ["x86_64", "arm64"]},
        "package_type": {"enum": ["Zip", "Image"]}
      },
      "needs": [
        {"kind": "data", "type": "archive_file", "new": true, "name": "{{name}}", "refs": {"filename": "output_path", "source_code_hash": "output_base64sha256"}},
        {"type": "aws_iam_role", "new": true, "name": "{{name}}_role", "refs": {"role": "arn"}}
      ],
      "companions": [
        {"type": "aws_cloudwatch_log_group", "name": "{{name}}_logs", "init": {
          "exprs": {"name": "\"/aws/lambda/${{{self}}.function_name}\""},
          "attrs": {"retention_in_days": 14}
        }},
        {"type": "aws_iam_role_policy", "name": "{{name}}_logs", "init": {
          "exprs": {
            "role": "{{need:aws_iam_role}}.id",
            "policy": "jsonencode({\n  Version = \"2012-10-17\"\n  Statement = [{\n    Effect   = \"Allow\"\n    Action   = [\"logs:CreateLogStream\", \"logs:PutLogEvents\"]\n    Resource = [\"${{{need:aws_cloudwatch_log_group}}.arn}:*\"]\n  }]\n})"
          }
        }}
      ]
    },
    "aws_lambda_function_url": {
      "label": "Lambda Function URL", "icon": "link", "popular": true, "name": "function_url",
      "description": "Public HTTPS endpoint for a Lambda function.",
      "attrs": {
        "authorization_type": {"basic": true, "enum": ["NONE", "AWS_IAM"], "default": "NONE", "init": "NONE"}
      },
      "needs": [{"type": "aws_lambda_function", "refs": {"function_name": "function_name"}}]
    },
    "aws_lambda_permission": {
      "label": "Lambda Permission", "icon": "shield-check", "name": "permission",
      "attrs": {"action": {"basic": true, "default": "lambda:InvokeFunction"}, "principal": {"basic": true}, "source_arn": {"basic": true}}
    },
    "aws_lambda_event_source_mapping": {
      "label": "Lambda Event Source Mapping", "icon": "plug", "name": "trigger",
      "attrs": {
        "batch_size": {"basic": true},
        "starting_position": {"basic": true, "enum": ["LATEST", "TRIM_HORIZON", "AT_TIMESTAMP"]},
        "enabled": {"basic": true, "default": true}
      }
    },
    "aws_lambda_layer_version": {"label": "Lambda Layer", "icon": "layers"},
    "aws_lambda_alias": {"label": "Lambda Alias", "icon": "zap"},
    "aws_apigatewayv2_api": {
      "label": "HTTP API (API Gateway v2)", "icon": "waypoints", "popular": true, "name": "http_api",
      "description": "Low-latency HTTP or WebSocket API in front of Lambda and other backends.",
      "attrs": {
        "name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "protocol_type": {"basic": true, "enum": ["HTTP", "WEBSOCKET"], "default": "HTTP", "init": "HTTP"},
        "description": {"basic": true}
      }
    },
    "aws_apigatewayv2_route": {
      "label": "API Route", "icon": "route", "name": "route",
      "attrs": {"route_key": {"basic": true, "default": "ANY /{proxy+}"}, "target": {"basic": true}}
    },
    "aws_apigatewayv2_integration": {
      "label": "API Integration", "icon": "plug", "name": "integration",
      "attrs": {
        "integration_type": {"basic": true, "enum": ["AWS_PROXY", "HTTP_PROXY", "MOCK", "AWS", "HTTP"]},
        "payload_format_version": {"basic": true, "enum": ["1.0", "2.0"]}
      }
    },
    "aws_apigatewayv2_stage": {
      "label": "API Stage", "icon": "rocket", "name": "stage",
      "attrs": {"name": {"basic": true, "default": "$default"}, "auto_deploy": {"basic": true, "default": true}}
    },
    "aws_api_gateway_rest_api": {
      "label": "REST API (API Gateway)", "icon": "waypoints", "popular": true, "name": "rest_api",
      "description": "Feature-rich REST API with stages, usage plans and API keys.",
      "attrs": {"name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"}, "description": {"basic": true}}
    },
    "aws_api_gateway_resource": {"label": "REST API Resource", "icon": "route"},
    "aws_api_gateway_method": {"label": "REST API Method", "icon": "route"},
    "aws_api_gateway_integration": {"label": "REST API Integration", "icon": "plug"},
    "aws_api_gateway_deployment": {"label": "REST API Deployment", "icon": "rocket"},
    "aws_api_gateway_stage": {"label": "REST API Stage", "icon": "rocket"},
    "aws_iam_role": {
      "label": "IAM Role", "icon": "key-round", "popular": true, "name": "role",
      "description": "Identity with permissions that AWS services (e.g. Lambda) can assume.",
      "attrs": {
        "name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "assume_role_policy": {"basic": true, "expr": "jsonencode({\n  Version = \"2012-10-17\"\n  Statement = [{\n    Effect    = \"Allow\"\n    Principal = { Service = \"lambda.amazonaws.com\" }\n    Action    = \"sts:AssumeRole\"\n  }]\n})"}
      }
    },
    "aws_iam_policy": {
      "label": "IAM Policy", "icon": "file-key", "popular": true, "name": "policy",
      "description": "Reusable managed permissions policy. Starts with write access to Lambda log groups.",
      "attrs": {
        "name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "policy": {"basic": true, "expr": "jsonencode({\n  Version = \"2012-10-17\"\n  Statement = [{\n    Effect   = \"Allow\"\n    Action   = [\"logs:CreateLogGroup\", \"logs:CreateLogStream\", \"logs:PutLogEvents\"]\n    Resource = [\"arn:aws:logs:*:*:log-group:/aws/lambda/*\"]\n  }]\n})"}
      }
    },
    "aws_iam_role_policy": {"label": "IAM Inline Role Policy", "icon": "file-key", "name": "policy"},
    "aws_iam_role_policy_attachment": {"label": "IAM Policy Attachment", "icon": "link", "name": "attachment"},
    "aws_iam_user": {"label": "IAM User", "icon": "user"},
    "aws_iam_group": {"label": "IAM Group", "icon": "users"},
    "aws_iam_instance_profile": {"label": "IAM Instance Profile", "icon": "id-card"},
    "aws_cloudwatch_log_group": {
      "label": "CloudWatch Log Group", "icon": "scroll-text", "popular": true, "name": "logs",
      "description": "Stores and retains log streams.",
      "attrs": {
        "name": {"basic": true, "init": "/app/{{slug}}", "naming": "/${local.name_prefix}/{{slug}}"},
        "retention_in_days": {"basic": true, "default": 14, "init": 14, "enum": ["1", "3", "5", "7", "14", "30", "60", "90", "120", "150", "180", "365", "400", "545", "731", "1096", "1827", "2192", "2557", "2922", "3288", "3653"]}
      }
    },
    "aws_cloudwatch_metric_alarm": {
      "label": "CloudWatch Alarm", "icon": "bell", "name": "alarm",
      "attrs": {
        "comparison_operator": {"basic": true, "enum": ["GreaterThanOrEqualToThreshold", "GreaterThanThreshold", "LessThanThreshold", "LessThanOrEqualToThreshold"]},
        "statistic": {"basic": true, "enum": ["SampleCount", "Average", "Sum", "Minimum", "Maximum"]}
      }
    },
    "aws_cloudwatch_dashboard": {"label": "CloudWatch Dashboard", "icon": "layout-dashboard"},
    "aws_cloudwatch_event_rule": {
      "label": "EventBridge Rule", "icon": "calendar-clock", "popular": true, "name": "rule",
      "description": "Matches events or runs on a schedule and routes them to targets.",
      "attrs": {
        "name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "schedule_expression": {"basic": true, "default": "rate(5 minutes)", "init": "rate(5 minutes)"},
        "event_pattern": {"basic": true},
        "description": {"basic": true}
      }
    },
    "aws_cloudwatch_event_target": {"label": "EventBridge Target", "icon": "crosshair", "name": "target"},
    "aws_cloudwatch_event_bus": {"label": "EventBridge Event Bus", "icon": "radio"},
    "aws_scheduler_schedule": {
      "label": "EventBridge Schedule", "icon": "alarm-clock", "popular": true, "name": "schedule",
      "description": "Invokes a target on a cron or rate schedule. Starts as a heartbeat that calls STS; connect it to a Lambda to run your code.",
      "attrs": {
        "name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "schedule_expression": {"basic": true, "default": "rate(5 minutes)", "init": "rate(5 minutes)"},
        "state": {"basic": true, "enum": ["ENABLED", "DISABLED"]},
        "flexible_time_window.mode": {"enum": ["OFF", "FLEXIBLE"]}
      },
      "blocks": [
        {"type": "flexible_time_window", "attrs": {"mode": "OFF"}},
        {"type": "target", "attrs": {"arn": "arn:aws:scheduler:::aws-sdk:sts:getCallerIdentity", "input": "{}"}, "exprs": {"role_arn": "{{need:aws_iam_role}}.arn"}}
      ],
      "needs": [
        {"type": "aws_iam_role", "new": true, "name": "{{name}}_role", "init": {"exprs": {
          "assume_role_policy": "jsonencode({\n  Version = \"2012-10-17\"\n  Statement = [{\n    Effect    = \"Allow\"\n    Principal = { Service = \"scheduler.amazonaws.com\" }\n    Action    = \"sts:AssumeRole\"\n  }]\n})"
        }}}
      ]
    },
    "aws_scheduler_schedule_group": {"label": "EventBridge Schedule Group", "icon": "alarm-clock"},
    "aws_kinesis_stream": {
      "label": "Kinesis Data Stream", "icon": "waves", "popular": true, "name": "stream",
      "description": "Real-time data stream with ordered, replayable records, encrypted with the AWS managed key.",
      "attrs": {
        "name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "shard_count": {"basic": true, "default": 1, "init": 1},
        "retention_period": {"basic": true, "default": 24},
        "encryption_type": {"enum": ["NONE", "KMS"], "init": "KMS"},
        "kms_key_id": {"init": "alias/aws/kinesis"}
      }
    },
    "aws_kinesis_firehose_delivery_stream": {"label": "Data Firehose Stream", "icon": "waves"},
    "aws_sfn_state_machine": {
      "label": "Step Functions State Machine", "icon": "workflow", "popular": true, "name": "state_machine",
      "description": "Orchestrates multi-step workflows. Starts with a single Pass state.",
      "attrs": {
        "name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "type": {"basic": true, "enum": ["STANDARD", "EXPRESS"], "default": "STANDARD"},
        "definition": {"basic": true, "expr": "jsonencode({\n  Comment = \"Starter state machine\"\n  StartAt = \"Hello\"\n  States = {\n    Hello = {\n      Type   = \"Pass\"\n      Result = { message = \"Hello from Step Functions\" }\n      End    = true\n    }\n  }\n})"}
      },
      "needs": [
        {"type": "aws_iam_role", "new": true, "name": "{{name}}_role", "refs": {"role_arn": "arn"}, "init": {"exprs": {
          "assume_role_policy": "jsonencode({\n  Version = \"2012-10-17\"\n  Statement = [{\n    Effect    = \"Allow\"\n    Principal = { Service = \"states.amazonaws.com\" }\n    Action    = \"sts:AssumeRole\"\n  }]\n})"
        }}}
      ]
    },
    "aws_secretsmanager_secret": {
      "label": "Secrets Manager Secret", "icon": "lock", "popular": true, "name": "secret",
      "description": "Stores credentials and other secrets with rotation support.",
      "attrs": {
        "name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "recovery_window_in_days": {"basic": true, "default": 0, "init": 0},
        "description": {"basic": true}
      }
    },
    "aws_secretsmanager_secret_version": {"label": "Secret Value", "icon": "lock", "name": "secret_value"},
    "aws_ssm_parameter": {
      "label": "SSM Parameter", "icon": "sliders-horizontal", "popular": true, "name": "parameter",
      "description": "Configuration value in Parameter Store.",
      "attrs": {
        "name": {"basic": true, "init": "/app/{{slug}}", "naming": "/${local.name_prefix}/{{slug}}"},
        "type": {"basic": true, "enum": ["String", "StringList", "SecureString"], "default": "String", "init": "String"},
        "value": {"basic": true, "init": "{}"},
        "description": {"basic": true}
      }
    },
    "aws_kms_key": {
      "label": "KMS Key", "icon": "key-round", "popular": true, "name": "key",
      "description": "Customer managed encryption key.",
      "attrs": {
        "description": {"basic": true, "init": "{{name}} encryption key"},
        "deletion_window_in_days": {"basic": true, "default": 7, "init": 7},
        "enable_key_rotation": {"basic": true, "default": true, "init": true}
      }
    },
    "aws_kms_alias": {"label": "KMS Alias", "icon": "key-round"},
    "aws_vpc": {
      "label": "VPC", "icon": "network", "popular": true, "name": "vpc",
      "description": "Isolated virtual network for your resources.",
      "attrs": {
        "cidr_block": {"basic": true, "default": "10.0.0.0/16", "init": "10.0.0.0/16"},
        "enable_dns_support": {"basic": true, "default": true, "init": true},
        "enable_dns_hostnames": {"basic": true, "default": true, "init": true}
      }
    },
    "aws_subnet": {
      "label": "Subnet", "icon": "network", "popular": true, "name": "subnet",
      "description": "IP range inside a VPC.",
      "attrs": {
        "cidr_block": {"basic": true, "init": "10.0.{{seq}}.0/24"},
        "availability_zone": {"basic": true},
        "map_public_ip_on_launch": {"basic": true, "default": false}
      },
      "needs": [{"type": "aws_vpc", "refs": {"vpc_id": "id"}}]
    },
    "aws_security_group": {
      "label": "Security Group", "icon": "shield", "popular": true, "name": "security_group",
      "description": "Stateful firewall rules for instances, load balancers and functions.",
      "attrs": {
        "name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "description": {"basic": true, "init": "{{name}} security group"}
      },
      "blocks": [{"type": "egress", "attrs": {"description": "All outbound traffic", "from_port": 0, "to_port": 0, "protocol": "-1", "cidr_blocks": ["0.0.0.0/0"]}}],
      "needs": [{"type": "aws_vpc", "optional": true, "refs": {"vpc_id": "id"}}]
    },
    "aws_vpc_security_group_ingress_rule": {"label": "Security Group Ingress Rule", "icon": "shield"},
    "aws_vpc_security_group_egress_rule": {"label": "Security Group Egress Rule", "icon": "shield"},
    "aws_internet_gateway": {
      "label": "Internet Gateway", "icon": "globe", "name": "igw",
      "needs": [{"type": "aws_vpc", "refs": {"vpc_id": "id"}}]
    },
    "aws_nat_gateway": {"label": "NAT Gateway", "icon": "router"},
    "aws_eip": {"label": "Elastic IP", "icon": "globe"},
    "aws_route_table": {
      "label": "Route Table", "icon": "route", "name": "route_table",
      "needs": [{"type": "aws_vpc", "refs": {"vpc_id": "id"}}]
    },
    "aws_route_table_association": {"label": "Route Table Association", "icon": "link"},
    "aws_route": {"label": "Route", "icon": "route"},
    "aws_instance": {
      "label": "EC2 Instance", "icon": "server", "popular": true, "name": "instance",
      "description": "Virtual machine. Starts from the latest Amazon Linux 2023 image, with IMDSv2 required.",
      "attrs": {
        "instance_type": {"basic": true, "default": "t3.micro", "init": "t3.micro", "enum": ["t3.nano", "t3.micro", "t3.small", "t3.medium", "t3.large", "t4g.micro", "t4g.small", "m7i.large", "c7i.large"]},
        "ami": {"basic": true}
      },
      "blocks": [{"type": "metadata_options", "attrs": {"http_tokens": "required"}}],
      "needs": [
        {"type": "aws_subnet", "optional": true, "refs": {"subnet_id": "id"}},
        {"kind": "data", "type": "aws_ami", "refs": {"ami": "id"}}
      ]
    },
    "aws_launch_template": {"label": "Launch Template", "icon": "server"},
    "aws_autoscaling_group": {"label": "Auto Scaling Group", "icon": "scale"},
    "aws_ecs_cluster": {
      "label": "ECS Cluster", "icon": "boxes", "popular": true, "name": "cluster",
      "description": "Logical group for container services and tasks.",
      "attrs": {"name": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"}}
    },
    "aws_ecs_task_definition": {
      "label": "ECS Task Definition", "icon": "container", "popular": true, "name": "task",
      "description": "Container blueprint (image, CPU, memory, ports). Starts with nginx on Fargate.",
      "attrs": {
        "family": {"basic": true, "init": "{{slug}}", "naming": "${local.name_prefix}-{{slug}}"},
        "network_mode": {"basic": true, "enum": ["awsvpc", "bridge", "host", "none"], "init": "awsvpc"},
        "requires_compatibilities": {"basic": true, "init": ["FARGATE"]},
        "cpu": {"basic": true, "init": "256", "enum": ["256", "512", "1024", "2048", "4096"]},
        "memory": {"basic": true, "init": "512"},
        "container_definitions": {"basic": true, "expr": "jsonencode([{\n  name         = \"app\"\n  image        = \"nginx:alpine\"\n  essential    = true\n  portMappings = [{ containerPort = 80, protocol = \"tcp\" }]\n}])"}
      }
    },
    "aws_ecs_service": {
      "label": "ECS Service", "icon": "container", "name": "service",
      "attrs": {
