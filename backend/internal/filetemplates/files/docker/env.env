# Variables docker compose reads to fill ${VAR} in the compose files, and
# that services load with env_file: .env.
# Keep this file out of git (add .env to .gitignore): it holds local
# settings and credentials. Commit a .env.example with placeholders instead.

# Host port the app is published on.
APP_PORT=8080

# Connection string of the app's database (placeholder values).
DATABASE_URL=postgres://app:change-me@db:5432/app

LOG_LEVEL=info
