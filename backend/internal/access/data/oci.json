{
 "source": {
  "title": "OCI IAM Detailed Service Policy Reference",
  "url": "https://docs.oracle.com/en-us/iaas/Content/Identity/policyreference/policyreference.htm",
  "retrieved": "2026-10-24"
 },
 "verbs": [
  {
   "name": "inspect",
   "target": "Third-party auditors",
   "description": "Ability to list resources, without access to any confidential information or user-specified metadata that might be part of that resource. Important: The operation to list policies includes the contents of the policies themselves. The list operations for the Networking resource-types return all the information (for example, the contents of security lists and route tables)."
  },
  {
   "name": "read",
   "target": "Internal auditors",
   "description": "Includes inspect plus the ability to get user-specified metadata and the actual resource itself."
  },
  {
   "name": "use",
   "target": "Day-to-day end users of resources",
   "description": "Includes read plus the ability to work with existing resources (the actions vary by resource type). Includes the ability to update the resource, except for resource-types where the \"update\" operation has the same effective impact as the \"create\" operation (for example, UpdatePolicy , UpdateSecurityList , and more), in which case the \"update\" ability is available only with the manage verb. In general, this verb doesn't include the ability to create or delete that type of resource."
  },
  {
   "name": "manage",
   "target": "Administrators",
   "description": "Includes all permissions for the resource."
  }
 ],
